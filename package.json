{
    "name": "wealth",
    "version": "0.0.1",
    "description": "💵 wealth",
    "type": "module",
    "keywords": [
        "typescript",
        "react",
        "eslint",
        "prettier",
        "vitest",
        "cloudflare",
        "react-router",
        "react-router-v7",
        "tailwind",
        "hacktoberfest"
    ],
    "homepage": "https://github.com/bradgarropy/wealth",
    "bugs": {
        "url": "https://github.com/bradgarropy/wealth/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Brad Garropy",
        "email": "bradgarropy@gmail.com",
        "url": "https://bradgarropy.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/bradgarropy/wealth"
    },
    "scripts": {
        "build": "react-router build",
        "build:demo": "CLOUDFLARE_ENV=demo react-router build",
        "contributors": "all-contributors generate",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "db:migrate:demo": "wrangler d1 migrations apply DB --remote --env demo",
        "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
        "db:seed": "tsx scripts/seed.ts",
        "db:seed:demo": "tsx scripts/seed.ts --demo",
        "deploy": "npm run db:migrate:prod && wrangler deploy",
        "deploy:demo": "npm run db:migrate:demo && npm run build:demo && wrangler deploy",
        "dev": "react-router dev",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "npm run build && wrangler dev --local",
        "start": "npm run build && wrangler dev --local",
        "test": "vitest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:ui": "vitest --coverage --watch --ui",
        "test:watch": "vitest --coverage --watch",
        "typecheck": "npm run typegen && tsc",
        "typegen": "wrangler types && react-router typegen"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@sentry/cloudflare": "^10.53.1",
        "@sentry/react-router": "^10.53.1",
        "@tanstack/react-table": "^8.21.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "csv-parse": "^7.0.0",
        "csv-stringify": "^6.8.1",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.2",
        "isbot": "^5.1.40",
        "lucide-react": "^1.27.0",
        "react": "^19.2.6",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.6",
        "react-router": "^7.15.0",
        "recharts": "^3.9.1",
        "shadcn": "^4.16.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@bradgarropy/eslint-config": "^3.2.0",
        "@cloudflare/vite-plugin": "^1.36.4",
        "@playwright/test": "^1.60.0",
        "@react-router/dev": "^7.15.0",
        "@sentry/vite-plugin": "^5.3.0",
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.7.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.6",
        "@vitest/ui": "^4.1.6",
        "all-contributors-cli": "^6.20.0",
        "drizzle-kit": "^0.31.10",
        "jsdom": "^29.1.1",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "react-router-devtools": "^6.2.0",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.23.5",
        "typescript": "^6.0.3",
        "vite": "^8.0.12",
        "vite-plugin-devtools-json": "^1.0.0",
        "vitest": "^4.1.6",
        "wrangler": "^4.0.0"
    },
    "engines": {
        "node": ">=20"
    },
    "sideEffects": false
}
